# ========================================================
# [골프장 탐색·추천 서비스 환경 변수 설정 템플릿]
# 이 파일은 깃(Git)에 공유되는 공개 템플릿입니다.
# 실제 비밀 키는 여기에 입력하지 마시고, 복사한 .env 파일에 입력해 주세요.
# ========================================================

# 1. Supabase 데이터베이스 설정 (필수)
# Supabase 대시보드 -> Project Settings -> API 에서 확인 가능합니다.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. OpenAI API 설정 (필수 - AI 추천 사유 요약용)
# OpenAI 플랫폼(https://platform.openai.com/api-keys)에서 발급받은 API 키를 입력합니다.
OPENAI_API_KEY=your_openai_api_key_here

# 3. 날씨 정보 API 설정 (더미/샘플 모드 지원)
# 키가 없을 경우 USE_MOCK_WEATHER=true 설정으로 안전한 더미 데이터가 제공됩니다.
WEATHER_API_KEY=
USE_MOCK_WEATHER=true

# 4. 외부 골프장/예약 데이터 공급자 API 설정 (더미/샘플 모드 지원)
# 키가 없을 경우 USE_MOCK_COURSE_DATA=true 설정으로 현실적인 샘플 티타임·가격이 제공됩니다.
COURSE_DATA_API_KEY=
USE_MOCK_COURSE_DATA=true
